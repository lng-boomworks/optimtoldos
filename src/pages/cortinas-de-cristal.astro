---
import Base from '../layouts/Base.astro';
import { CortinasPage } from '../components/pages/CortinasPage';
import { buildServiceSchema, buildFAQSchema, buildProductSchema } from '../utils/schema';
import { t } from '../i18n/index';
import { getAlternateUrls } from '../i18n/routes';

const alternateUrls = getAlternateUrls('glass-curtains');

const serviceSchema = buildServiceSchema({
  locale: 'es',
  name: "Cortinas de Cristal en Alicante",
  description: "Instalación de cortinas de cristal templado plegables sin perfiles verticales para cerramientos de terrazas.",
  serviceType: "Instalación de cortinas de cristal",
  url: "https://optimtoldos.com/cortinas-de-cristal",
  offers: [
    { name: "Cortina de Cristal Plegable" },
    { name: "Cortina de Cristal Abatible" },
    { name: "Cerramiento de Cristal" },
  ],
});

const faqSchema = buildFAQSchema(
  Array.from({ length: 8 }, (_, i) => ({
    question: t('es', `curtains.faq.${i + 1}.q` as any),
    answer: t('es', `curtains.faq.${i + 1}.a` as any),
  })),
  { locale: 'es' }
);

const productSchema = buildProductSchema({
  locale: 'es',
  name: "Cortinas de Cristal en Alicante",
  description: "Cortinas de cristal templado plegables sin perfiles verticales. Cierra tu terraza sin perder las vistas. Instalación profesional en Alicante.",
  image: "https://optimtoldos.com/images/cortinas/hero-cortinas.webp",
  url: "https://optimtoldos.com/cortinas-de-cristal",
  lowPrice: "250",
  highPrice: "450",
  category: "Cortinas de cristal",
});
---

<Base
  title="Cortinas de Cristal | Optim Toldos - Alicante"
  description="Cortinas de cristal templado plegables sin perfiles verticales. Cierra tu terraza sin perder las vistas. Instalación profesional en Alicante y Costa Blanca."
  locale="es"
  alternateUrls={alternateUrls}
  breadcrumbs={[
    { name: "Inicio", url: "https://optimtoldos.com/" },
    { name: "Cortinas de Cristal", url: "https://optimtoldos.com/cortinas-de-cristal" },
  ]}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  </Fragment>
  <CortinasPage client:load locale="es" />
</Base>
