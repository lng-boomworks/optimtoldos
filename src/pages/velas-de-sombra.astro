---
import Base from '../layouts/Base.astro';
import { VelasPage } from '../components/pages/VelasPage';
import { buildFAQSchema, buildServiceSchema, buildProductSchema } from '../utils/schema';
import { t } from '../i18n/index';
import { getAlternateUrls } from '../i18n/routes';

const alternateUrls = getAlternateUrls('shade-sails');

const velasFaqs = Array.from({ length: 7 }, (_, i) => ({
  question: t('es', `sails.faq.${i + 1}.q` as any),
  answer: t('es', `sails.faq.${i + 1}.a` as any),
}));

const breadcrumbs = [
  { name: "Inicio", url: "https://optimtoldos.com/" },
  { name: "Velas de Sombra", url: "https://optimtoldos.com/velas-de-sombra" },
];

const productSchema = buildProductSchema({
  locale: 'es',
  name: "Velas de Sombra en Alicante",
  description: "Velas de sombra triangulares, rectangulares y personalizadas. 95% protección UV certificada. Diseño arquitectónico a medida.",
  image: "https://optimtoldos.com/images/velas/hero-velas.webp",
  url: "https://optimtoldos.com/velas-de-sombra",
  lowPrice: "200",
  highPrice: "1500",
  category: "Velas de sombra",
});
---

<Base
  title="Velas de Sombra | Optim Toldos - Alicante"
  description="Velas de sombra tensadas con protección UV certificada. Diseño triangular, rectangular y personalizado para terrazas y jardines en Alicante."
  breadcrumbs={breadcrumbs}
  locale="es"
  alternateUrls={alternateUrls}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(buildServiceSchema({
  locale: 'es',
      name: "Velas de Sombra en Alicante",
      description: "Diseño e instalación de velas de sombra tensadas con protección UV certificada para terrazas, jardines y piscinas.",
      serviceType: "Instalación de velas de sombra",
      url: "https://optimtoldos.com/velas-de-sombra",
      offers: [{ name: "Vela Triangular" }, { name: "Vela Rectangular" }, { name: "Vela Personalizada" }],
    }))} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(buildFAQSchema(velasFaqs, { locale: 'es' }))} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  </Fragment>
  <VelasPage client:load locale="es" />
</Base>
