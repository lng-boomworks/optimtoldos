---
import Base from '../layouts/Base.astro';
import { PergolasPage } from '../components/pages/PergolasPage';
import { buildServiceSchema, buildFAQSchema, buildProductSchema } from '../utils/schema';
import { t } from '../i18n/index';
import { getAlternateUrls } from '../i18n/routes';

const alternateUrls = getAlternateUrls('pergolas');

const serviceSchema = buildServiceSchema({
  name: "Pérgolas Bioclimáticas en Alicante",
  description: "Diseño e instalación de pérgolas bioclimáticas de aluminio con lamas orientables, motorización inteligente e iluminación LED.",
  serviceType: "Instalación de pérgolas",
  url: "https://optimtoldos.com/pergolas",
  offers: [
    { name: "Pérgola Bioclimática" },
    { name: "Pérgola Adosada" },
    { name: "Pérgola Autoportante" },
  ],
});

const faqSchema = buildFAQSchema(
  Array.from({ length: 8 }, (_, i) => ({
    question: t('es', `pergolas.faq.${i + 1}.q` as any),
    answer: t('es', `pergolas.faq.${i + 1}.a` as any),
  }))
);

const productSchema = buildProductSchema({
  name: "Pérgolas Bioclimáticas en Alicante",
  description: "Pérgolas bioclimáticas de aluminio con lamas orientables, motorización y LED integrado. Fabricación a medida e instalación profesional.",
  image: "https://optimtoldos.com/images/pergolas/hero-pergolas.webp",
  url: "https://optimtoldos.com/pergolas",
  lowPrice: "3000",
  highPrice: "12000",
  category: "Pérgolas bioclimáticas",
});
---

<Base
  title="Pérgolas Bioclimáticas | Optim Toldos — Alicante"
  description="Pérgolas de aluminio con lamas orientables. Regulación de luz, ventilación y protección contra lluvia. Instalación profesional en Alicante y Costa Blanca."
  locale="es"
  alternateUrls={alternateUrls}
  breadcrumbs={[
    { name: "Inicio", url: "https://optimtoldos.com/" },
    { name: "Pérgolas", url: "https://optimtoldos.com/pergolas" },
  ]}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  </Fragment>
  <PergolasPage client:load locale="es" />
</Base>
