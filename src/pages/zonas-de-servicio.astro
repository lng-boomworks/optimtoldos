---
import Base from '../layouts/Base.astro';
import { ServiceAreasPage } from '../components/pages/ServiceAreasPage';
import { buildCollectionPageSchema } from '../utils/schema';
import { getAlternateUrls } from '../i18n/routes';

const alternateUrls = getAlternateUrls('service-areas');

// CollectionPage now points at the dedicated per-area URLs (PDF §3 fix —
// Google can rank /toldos-{slug}/ as separate URLs, but never could rank
// #anchors). Source-of-truth list is SEO_LOCATIONS.
import { SEO_LOCATIONS } from '../data/seoLocations';

const schema = buildCollectionPageSchema({
  locale: 'es',
  name: 'Zonas de servicio - Optim Toldos',
  description: 'Áreas donde Optim Toldos instala toldos, pérgolas, cortinas de cristal, velas de sombra y ventanas PVC en la provincia de Alicante.',
  url: 'https://optimtoldos.com/zonas-de-servicio',
  items: SEO_LOCATIONS.map(l => ({
    name: l.name,
    url: `https://optimtoldos.com/toldos-${l.slug}/`,
  })),
});

const breadcrumbs = [
  { name: 'Inicio', url: 'https://optimtoldos.com/' },
  { name: 'Zonas de Servicio', url: 'https://optimtoldos.com/zonas-de-servicio' },
];
---

<Base
  title="Zonas de Servicio | Optim Toldos - Costa Blanca"
  description="Instalamos toldos, pérgolas, cortinas de cristal, velas de sombra y ventanas PVC en toda la provincia de Alicante. Descubre nuestras 20 zonas de servicio."
  breadcrumbs={breadcrumbs}
  locale="es"
  alternateUrls={alternateUrls}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>
  <ServiceAreasPage client:load locale="es" />
</Base>
