---
import Base from '../layouts/Base.astro';
import { ToldosPage } from '../components/pages/ToldosPage';
import { buildServiceSchema, buildFAQSchema, buildProductSchema } from '../utils/schema';
import { t } from '../i18n/index';
import { getAlternateUrls } from '../i18n/routes';

const alternateUrls = getAlternateUrls('awnings');

const serviceSchema = buildServiceSchema({
  locale: 'es',
  name: "Toldos a Medida en Alicante",
  description: "Fabricación e instalación de toldos extensibles, verticales, punto recto y capota a medida.",
  serviceType: "Instalación de toldos",
  url: "https://optimtoldos.com/toldos",
  offers: [
    { name: "Toldo Brazo Extensible" },
    { name: "Toldo Punto Recto" },
    { name: "Toldo Vertical / Screen" },
    { name: "Toldo Capota" },
    { name: "Toldo de Ventana" },
  ],
});

const faqSchema = buildFAQSchema(
  Array.from({ length: 8 }, (_, i) => ({
    question: t('es', `awnings.faq.${i + 1}.q` as any),
    answer: t('es', `awnings.faq.${i + 1}.a` as any),
  })),
  { locale: 'es' }
);

const productSchema = buildProductSchema({
  locale: 'es',
  name: "Toldos a Medida en Alicante",
  description: "Toldos extensibles, verticales, punto recto y capota fabricados a medida con instalación profesional en la provincia de Alicante.",
  image: "https://optimtoldos.com/images/gallery/hero-toldos.webp",
  url: "https://optimtoldos.com/toldos",
  lowPrice: "350",
  highPrice: "1500",
  category: "Toldos",
});
---

<Base
  title="Toldos a Medida | Optim Toldos - Alicante"
  description="Toldos extensibles, verticales, punto recto y capota. Fabricación a medida con motorización opcional e instalación profesional en Alicante y Costa Blanca."
  locale="es"
  alternateUrls={alternateUrls}
  breadcrumbs={[
    { name: "Inicio", url: "https://optimtoldos.com/" },
    { name: "Toldos", url: "https://optimtoldos.com/toldos" },
  ]}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  </Fragment>
  <ToldosPage client:load locale="es" />
</Base>
