---
import Base from '../layouts/Base.astro';
import { AwningPricesPage } from '../components/pages/AwningPricesPage';
import { buildFAQSchema, buildBreadcrumbSchema, buildServiceSchema } from '../utils/schema';
import { t } from '../i18n/index';
import { getAlternateUrls } from '../i18n/routes';

const alternateUrls = getAlternateUrls('awning-prices-2026');
const pageUrl = 'https://optimtoldos.com/precio-toldos-alicante-2026';

const faqs = Array.from({ length: 8 }, (_, i) => ({
  question: t('es', `pricesGuide.faq.${i + 1}.q` as any),
  answer: t('es', `pricesGuide.faq.${i + 1}.a` as any),
}));

const breadcrumbs = [
  { name: 'Inicio', url: 'https://optimtoldos.com/' },
  { name: 'Precio de toldos 2026', url: pageUrl },
];

const faqSchema = buildFAQSchema(faqs, { locale: 'es' });
const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbs, { locale: 'es' });
const serviceSchema = buildServiceSchema({
  locale: 'es',
  name: 'Precios de toldos en Alicante 2026',
  description: 'Tablas de precios reales para toldos cofre, brazo extensible, ZIP vertical, motorización y sensores en la provincia de Alicante.',
  serviceType: 'Instalación y suministro de toldos',
  url: pageUrl,
  offers: [
    { name: 'Toldo cofre completo' },
    { name: 'Toldo brazo extensible' },
    { name: 'Toldo ZIP vertical' },
    { name: 'Motorización Somfy y Nice' },
    { name: 'Sensor de viento Eolis 3D' },
  ],
});
---

<Base
  title={t('es', 'pricesGuide.title')}
  description={t('es', 'pricesGuide.meta_description')}
  breadcrumbs={breadcrumbs}
  locale="es"
  alternateUrls={alternateUrls}
  type="article"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  </Fragment>
  <AwningPricesPage client:load locale="es" />
</Base>
