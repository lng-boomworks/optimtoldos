---
import Base from '../layouts/Base.astro';
import { AwningBuyingGuidePage } from '../components/pages/AwningBuyingGuidePage';
import { buildFAQSchema } from '../utils/schema';
import { t } from '../i18n/index';
import { getAlternateUrls } from '../i18n/routes';

const alternateUrls = getAlternateUrls('awning-guide');

const faqs = Array.from({ length: 6 }, (_, i) => ({
  question: t('es', `awningGuide.faq.${i + 1}.q` as any),
  answer: t('es', `awningGuide.faq.${i + 1}.a` as any),
}));

const breadcrumbs = [
  { name: 'Inicio', url: 'https://optimtoldos.com/' },
  { name: 'Guía para elegir toldo', url: 'https://optimtoldos.com/guia-elegir-toldo-costa-blanca' },
];
---

<Base
  title={t('es', 'awningGuide.title')}
  description={t('es', 'awningGuide.meta_description')}
  breadcrumbs={breadcrumbs}
  locale="es"
  alternateUrls={alternateUrls}
  type="article"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(buildFAQSchema(faqs))} />
  </Fragment>
  <AwningBuyingGuidePage client:load locale="es" />
</Base>
