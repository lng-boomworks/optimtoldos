---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
  const SITE = 'https://optimtoldos.com';
  const posts = await getCollection('blog');
  const enPosts = posts.filter((p) => (p.data.locale ?? 'es') === 'en');

  return posts
    .filter((p) => (p.data.locale ?? 'es') === 'es')
    .map((post) => {
      const enPair = enPosts.find((p) => p.data.translationOf === post.id);
      const esSlug = post.id.replace(/^es\//, '');
      const alternateUrls = enPair
        ? [
            { locale: 'es' as const, href: `${SITE}/blog/${esSlug}/` },
            { locale: 'en' as const, href: `${SITE}/en/blog/${enPair.id.replace(/^en\//, '')}/` },
          ]
        : [];
      return {
        params: { slug: esSlug },
        props: { post, alternateUrls },
      };
    });
}

const { post, alternateUrls } = Astro.props;
const { Content } = await render(post);
---

<BlogPost
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  updated={post.data.updated}
  author={post.data.author}
  image={post.data.image}
  category={post.data.category}
  tags={post.data.tags}
  slug={post.id}
  locale="es"
  pillarGuide={post.data.pillarGuide}
  alternateUrls={alternateUrls}
>
  <Content />
</BlogPost>
