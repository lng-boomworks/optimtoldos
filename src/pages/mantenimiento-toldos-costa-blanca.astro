---
import Base from '../layouts/Base.astro';
import { AwningMaintenancePage } from '../components/pages/AwningMaintenancePage';
import { buildFAQSchema, buildBreadcrumbSchema, buildServiceSchema } from '../utils/schema';
import { t } from '../i18n/index';
import { getAlternateUrls } from '../i18n/routes';

const alternateUrls = getAlternateUrls('awning-maintenance');
const pageUrl = 'https://optimtoldos.com/mantenimiento-toldos-costa-blanca';

const faqs = Array.from({ length: 7 }, (_, i) => ({
  question: t('es', `maintenanceGuide.faq.${i + 1}.q` as any),
  answer: t('es', `maintenanceGuide.faq.${i + 1}.a` as any),
}));

const breadcrumbs = [
  { name: 'Inicio', url: 'https://optimtoldos.com/' },
  { name: 'Mantenimiento de toldos', url: pageUrl },
];

const faqSchema = buildFAQSchema(faqs, { locale: 'es' });
const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbs, { locale: 'es' });
const serviceSchema = buildServiceSchema({
  locale: 'es',
  name: 'Mantenimiento de toldos en la Costa Blanca',
  description: 'Servicio de mantenimiento, limpieza y revisión de toldos en zona costera con aire salino. Calibración de sensores y revisiones post-temporal.',
  serviceType: 'Mantenimiento y servicio postventa de toldos',
  url: pageUrl,
  offers: [
    { name: 'Limpieza anual de lona' },
    { name: 'Lubricación de brazos y motor' },
    { name: 'Calibración de sensor de viento' },
    { name: 'Revisión post-temporal' },
    { name: 'Sustitución de lona' },
  ],
});
---

<Base
  title={t('es', 'maintenanceGuide.title')}
  description={t('es', 'maintenanceGuide.meta_description')}
  breadcrumbs={breadcrumbs}
  locale="es"
  alternateUrls={alternateUrls}
  type="article"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  </Fragment>
  <AwningMaintenancePage client:load locale="es" />
</Base>
