---
import Base from '../../layouts/Base.astro';
import { ServiceAreasPage } from '../../components/pages/ServiceAreasPage';
import { buildCollectionPageSchema } from '../../utils/schema';
import { getAlternateUrls } from '../../i18n/routes';

const alternateUrls = getAlternateUrls('service-areas');

// CollectionPage now points at the dedicated per-area URLs. The 14 EN-supported
// locations link to /en/awnings-{slug}/; the remaining 6 locations have no EN
// counterpart (PDF §4) and link back to the ES page.
import { SEO_LOCATIONS } from '../../data/seoLocations';

const EN_AREA_SLUGS = new Set([
  'torrevieja','orihuela-costa','ciudad-quesada','guardamar','la-marina','elche',
  'alicante','santa-pola','gran-alacant','benidorm','cabo-roig','la-zenia',
  'punta-prima','villamartin',
]);

const schema = buildCollectionPageSchema({
  locale: 'en',
  name: 'Service Areas - Optim Toldos',
  description: 'Areas where Optim Toldos installs awnings, pergolas, glass curtains, shade sails and PVC windows across the province of Alicante.',
  url: 'https://optimtoldos.com/en/service-areas',
  items: SEO_LOCATIONS.map(l => ({
    name: l.name,
    url: EN_AREA_SLUGS.has(l.slug)
      ? `https://optimtoldos.com/en/awnings-${l.slug}/`
      : `https://optimtoldos.com/toldos-${l.slug}/`,
  })),
});

const breadcrumbs = [
  { name: 'Home', url: 'https://optimtoldos.com/en/' },
  { name: 'Service Areas', url: 'https://optimtoldos.com/en/service-areas' },
];
---

<Base
  title="Service Areas | Optim Toldos - Costa Blanca"
  description="We install awnings, pergolas, glass curtains, shade sails and PVC windows across the province of Alicante. See our 20 service areas."
  breadcrumbs={breadcrumbs}
  locale="en"
  alternateUrls={alternateUrls}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>
  <ServiceAreasPage client:load locale="en" />
</Base>
