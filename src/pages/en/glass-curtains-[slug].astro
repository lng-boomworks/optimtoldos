---
import Base from '../../layouts/Base.astro';
import { AreaPage } from '../../components/pages/AreaPage';
import {
  buildServiceSchema,
  buildBreadcrumbSchema,
} from '../../utils/schema';
import { SEO_LOCATIONS } from '../../data/seoLocations';
import { t } from '../../i18n/index';

const SITE = 'https://optimtoldos.com';

// EN glass-curtains-area pages. Originally Torrevieja + Elche per PDF §4;
// expanded 2026-04-30 with Alicante, Benidorm, Orihuela Costa to fill the
// /en/glass-curtains/ hub chip roster.
export async function getStaticPaths() {
  const allowed = new Set([
    'torrevieja','elche','alicante','benidorm','orihuela-costa',
  ]);
  return SEO_LOCATIONS
    .filter((loc) => allowed.has(loc.slug))
    .map((loc) => ({
      params: { slug: loc.slug },
      props: { i: loc.i, slug: loc.slug },
    }));
}

const { slug, i } = Astro.props;
const name = t('en', `serviceAreas.location.${i}.name` as any);
const body = t('en', `serviceAreas.location.${i}.body` as any);
const heading = t('en', 'areaPage.focus.curtains.heading').replace('{location}', name);
const intro = t('en', 'areaPage.focus.curtains.intro').replace('{location}', name);

// Pairs with ES product+zone /cortinas-de-cristal-{slug}/ (PDF §5)
const alternateUrls = [
  { locale: 'es' as const, href: `${SITE}/cortinas-de-cristal-${slug}/` },
  { locale: 'en' as const, href: `${SITE}/en/glass-curtains-${slug}/` },
];

const pageUrl = `${SITE}/en/glass-curtains-${slug}/`;

const serviceSchema = buildServiceSchema({
  locale: 'en',
  name: heading,
  description: body,
  serviceType: 'Glass curtain installation',
  url: pageUrl,
  offers: [
    { name: 'Sliding glass curtains' },
    { name: 'Folding glass curtains' },
    { name: 'Frameless terrace enclosure' },
  ],
});

const breadcrumbs = [
  { name: 'Home', url: `${SITE}/en/` },
  { name: 'Glass curtains', url: `${SITE}/en/glass-curtains/` },
  { name: heading, url: pageUrl },
];

const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbs, { locale: 'en' });
---

<Base
  title={`${heading} - Optim Toldos`}
  description={intro}
  locale="en"
  alternateUrls={alternateUrls}
  breadcrumbs={breadcrumbs}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>
  <AreaPage client:load locale="en" locationSlug={slug} focus="glass-curtains" />
</Base>
