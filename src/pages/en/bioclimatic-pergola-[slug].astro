---
import Base from '../../layouts/Base.astro';
import { AreaPage } from '../../components/pages/AreaPage';
import {
  buildServiceSchema,
  buildBreadcrumbSchema,
} from '../../utils/schema';
import { SEO_LOCATIONS } from '../../data/seoLocations';
import { t } from '../../i18n/index';

const SITE = 'https://optimtoldos.com';

// PDF §4: 2 EN bioclimatic-pergola pages (Torrevieja, Orihuela Costa)
export async function getStaticPaths() {
  const allowed = new Set(['torrevieja', 'orihuela-costa']);
  return SEO_LOCATIONS
    .filter((loc) => allowed.has(loc.slug))
    .map((loc) => ({
      params: { slug: loc.slug },
      props: { i: loc.i, slug: loc.slug },
    }));
}

const { slug, i } = Astro.props;
const name = t('en', `serviceAreas.location.${i}.name` as any);
const body = t('en', `serviceAreas.location.${i}.body` as any);
const heading = t('en', 'areaPage.focus.bioclimatic.heading').replace('{location}', name);
const intro = t('en', 'areaPage.focus.bioclimatic.intro').replace('{location}', name);

// Pairs with ES product+zone /pergola-bioclimatica-{slug}/ (PDF §5)
const alternateUrls = [
  { locale: 'es' as const, href: `${SITE}/pergola-bioclimatica-${slug}/` },
  { locale: 'en' as const, href: `${SITE}/en/bioclimatic-pergola-${slug}/` },
];

const pageUrl = `${SITE}/en/bioclimatic-pergola-${slug}/`;

const serviceSchema = buildServiceSchema({
  locale: 'en',
  name: heading,
  description: body,
  serviceType: 'Bioclimatic pergola installation',
  url: pageUrl,
  offers: [
    { name: 'Motorised bioclimatic pergolas' },
    { name: 'Adjustable louvre roof' },
    { name: 'Rain and wind sensors' },
  ],
});

const breadcrumbs = [
  { name: 'Home', url: `${SITE}/en/` },
  { name: 'Pergolas', url: `${SITE}/en/pergolas/` },
  { name: heading, url: pageUrl },
];

const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbs, { locale: 'en' });
---

<Base
  title={`${heading} - Optim Toldos`}
  description={intro}
  locale="en"
  alternateUrls={alternateUrls}
  breadcrumbs={breadcrumbs}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>
  <AreaPage client:load locale="en" locationSlug={slug} focus="bioclimatic-pergola" />
</Base>
