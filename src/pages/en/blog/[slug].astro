---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../../layouts/BlogPost.astro';

export async function getStaticPaths() {
  const SITE = 'https://optimtoldos.com';
  const posts = await getCollection('blog');
  return posts
    .filter((p) => (p.data.locale ?? 'es') === 'en')
    .map((post) => {
      const enSlug = post.id.replace(/^en\//, '');
      const esId = post.data.translationOf;
      const alternateUrls = esId
        ? [
            { locale: 'es' as const, href: `${SITE}/blog/${esId.replace(/^es\//, '')}/` },
            { locale: 'en' as const, href: `${SITE}/en/blog/${enSlug}/` },
          ]
        : [];
      return {
        params: { slug: enSlug },
        props: { post, alternateUrls },
      };
    });
}

const { post, alternateUrls } = Astro.props;
const { Content } = await render(post);
---

<BlogPost
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  updated={post.data.updated}
  author={post.data.author}
  image={post.data.image}
  category={post.data.category}
  tags={post.data.tags}
  slug={post.id}
  locale="en"
  pillarGuide={post.data.pillarGuide}
  alternateUrls={alternateUrls}
>
  <Content />
</BlogPost>
