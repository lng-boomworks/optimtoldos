---
import Base from '../../layouts/Base.astro';
import { AwningBuyingGuidePage } from '../../components/pages/AwningBuyingGuidePage';
import { buildFAQSchema } from '../../utils/schema';
import { t } from '../../i18n/index';
import { getAlternateUrls } from '../../i18n/routes';

const alternateUrls = getAlternateUrls('awning-guide');

const faqs = Array.from({ length: 6 }, (_, i) => ({
  question: t('en', `awningGuide.faq.${i + 1}.q` as any),
  answer: t('en', `awningGuide.faq.${i + 1}.a` as any),
}));

const breadcrumbs = [
  { name: 'Home', url: 'https://optimtoldos.com/en/' },
  { name: 'Choosing the right awning', url: 'https://optimtoldos.com/en/choosing-the-right-awning-costa-blanca' },
];
---

<Base
  title={t('en', 'awningGuide.title')}
  description={t('en', 'awningGuide.meta_description')}
  breadcrumbs={breadcrumbs}
  locale="en"
  alternateUrls={alternateUrls}
  type="article"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(buildFAQSchema(faqs, { locale: 'en' }))} />
  </Fragment>
  <AwningBuyingGuidePage client:load locale="en" />
</Base>
