---
import Base from '../../layouts/Base.astro';
import { AreaPage } from '../../components/pages/AreaPage';
import {
  buildServiceSchema,
  buildBreadcrumbSchema,
} from '../../utils/schema';
import { SEO_LOCATIONS } from '../../data/seoLocations';
import { t } from '../../i18n/index';

const SITE = 'https://optimtoldos.com';

// Per PDF §4: 14 EN awning area pages (excludes the 6 lower-priority Vega Baja
// + Orihuela suburb spots that don't get an EN-language counterpart)
const EN_AREA_LOCATIONS = new Set([
  'torrevieja','orihuela-costa','ciudad-quesada','guardamar','la-marina','elche',
  'alicante','santa-pola','gran-alacant','benidorm','cabo-roig','la-zenia',
  'punta-prima','villamartin',
]);

export async function getStaticPaths() {
  const allowed = new Set([
    'torrevieja','orihuela-costa','ciudad-quesada','guardamar','la-marina','elche',
    'alicante','santa-pola','gran-alacant','benidorm','cabo-roig','la-zenia',
    'punta-prima','villamartin',
  ]);
  return SEO_LOCATIONS
    .filter((loc) => allowed.has(loc.slug))
    .map((loc) => ({
      params: { slug: loc.slug },
      props: { i: loc.i, slug: loc.slug },
    }));
}

const { slug, i } = Astro.props;
const name = t('en', `serviceAreas.location.${i}.name` as any);
const body = t('en', `serviceAreas.location.${i}.body` as any);
const heading = t('en', 'areaPage.focus.awnings.heading').replace('{location}', name);
const intro = t('en', 'areaPage.focus.awnings.intro').replace('{location}', name);

const alternateUrls = [
  { locale: 'es' as const, href: `${SITE}/toldos-${slug}/` },
  { locale: 'en' as const, href: `${SITE}/en/awnings-${slug}/` },
];

const pageUrl = `${SITE}/en/awnings-${slug}/`;

const serviceSchema = buildServiceSchema({
  locale: 'en',
  name: heading,
  description: body,
  serviceType: 'Awning installation',
  url: pageUrl,
  offers: [
    { name: 'Cassette awnings' },
    { name: 'Retractable arm awnings' },
    { name: 'Vertical ZIP screen awnings' },
    { name: 'Bioclimatic pergolas' },
    { name: 'Glass curtains' },
  ],
});

const breadcrumbs = [
  { name: 'Home', url: `${SITE}/en/` },
  { name: 'Service areas', url: `${SITE}/en/service-areas/` },
  { name, url: pageUrl },
];

const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbs, { locale: 'en' });
---

<Base
  title={`${heading} - Optim Toldos`}
  description={intro}
  locale="en"
  alternateUrls={alternateUrls}
  breadcrumbs={breadcrumbs}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>
  <AreaPage client:load locale="en" locationSlug={slug} focus="awnings" />
</Base>
