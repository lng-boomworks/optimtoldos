---
import Base from '../../layouts/Base.astro';
import { VelasPage } from '../../components/pages/VelasPage';
import { buildFAQSchema, buildServiceSchema, buildProductSchema } from '../../utils/schema';
import { t } from '../../i18n/index';
import { getAlternateUrls } from '../../i18n/routes';

const alternateUrls = getAlternateUrls('shade-sails');

const sailsFaqs = Array.from({ length: 7 }, (_, i) => ({
  question: t('en', `sails.faq.${i + 1}.q` as any),
  answer: t('en', `sails.faq.${i + 1}.a` as any),
}));

const breadcrumbs = [
  { name: "Home", url: "https://optimtoldos.com/en/" },
  { name: "Shade Sails", url: "https://optimtoldos.com/en/shade-sails" },
];

const productSchema = buildProductSchema({
  locale: 'en',
  name: "Shade Sails in Alicante",
  description: "Triangular, rectangular and custom-shape shade sails. 95% certified UV protection. Architectural custom design.",
  image: "https://optimtoldos.com/images/velas/hero-velas.webp",
  url: "https://optimtoldos.com/en/shade-sails",
  lowPrice: "200",
  highPrice: "1500",
  category: "Shade sails",
});
---

<Base
  title="Shade Sails | Optim Toldos - Alicante"
  description="Tensioned shade sails with certified UV protection. Triangular, rectangular and custom designs for terraces and gardens in Alicante."
  locale="en"
  alternateUrls={alternateUrls}
  breadcrumbs={breadcrumbs}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(buildServiceSchema({
  locale: 'en',
      name: t('en', 'sails.hero.heading'),
      description: t('en', 'sails.hero.description'),
      serviceType: "Shade Sail Installation",
      url: "https://optimtoldos.com/en/shade-sails",
      offers: [{ name: "Triangular Sail" }, { name: "Rectangular Sail" }, { name: "Custom Sail" }],
    }))} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(buildFAQSchema(sailsFaqs, { locale: 'en' }))} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  </Fragment>
  <VelasPage client:load locale="en" />
</Base>
