---
import Base from '../../layouts/Base.astro';
import { AreaPage } from '../../components/pages/AreaPage';
import {
  buildServiceSchema,
  buildBreadcrumbSchema,
} from '../../utils/schema';
import { SEO_LOCATIONS, EN_SHADE_SAILS_LOCATIONS } from '../../data/seoLocations';
import { t } from '../../i18n/index';

const SITE = 'https://optimtoldos.com';

// EN shade-sails-area pages (added 2026-04-30) — mirror ES /velas-sombra-{slug}/.
export async function getStaticPaths() {
  const allowed = new Set<string>(EN_SHADE_SAILS_LOCATIONS);
  return SEO_LOCATIONS
    .filter((loc) => allowed.has(loc.slug))
    .map((loc) => ({
      params: { slug: loc.slug },
      props: { i: loc.i, slug: loc.slug },
    }));
}

const { slug, i } = Astro.props;
const name = t('en', `serviceAreas.location.${i}.name` as any);
const body = t('en', `serviceAreas.location.${i}.body` as any);
const heading = t('en', 'areaPage.focus.shadeSails.heading').replace('{location}', name);
const intro = t('en', 'areaPage.focus.shadeSails.intro').replace('{location}', name);

const alternateUrls = [
  { locale: 'es' as const, href: `${SITE}/velas-sombra-${slug}/` },
  { locale: 'en' as const, href: `${SITE}/en/shade-sails-${slug}/` },
];

const pageUrl = `${SITE}/en/shade-sails-${slug}/`;

const serviceSchema = buildServiceSchema({
  locale: 'en',
  name: heading,
  description: body,
  serviceType: 'Shade sail installation',
  url: pageUrl,
  offers: [
    { name: 'Triangular shade sail' },
    { name: 'Rectangular shade sail' },
    { name: 'Pentagonal / made-to-measure shade sail' },
  ],
});

const breadcrumbs = [
  { name: 'Home', url: `${SITE}/en/` },
  { name: 'Shade sails', url: `${SITE}/en/shade-sails/` },
  { name, url: pageUrl },
];

const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbs, { locale: 'en' });
---

<Base
  title={`${heading} - Optim Toldos`}
  description={intro}
  locale="en"
  alternateUrls={alternateUrls}
  breadcrumbs={breadcrumbs}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>
  <AreaPage client:load locale="en" locationSlug={slug} focus="shade-sails" />
</Base>
