---
import Base from '../../layouts/Base.astro';
import { Navbar } from '../../components/Navbar';
import { Footer } from '../../components/Footer';
import { getAlternateUrls } from '../../i18n/routes';
import { url } from '../../utils/paths';

const alternateUrls = getAlternateUrls('cookie-policy');

const breadcrumbs = [
  { name: "Home", url: "https://optimtoldos.com/en/" },
  { name: "Cookie Policy", url: "https://optimtoldos.com/en/cookie-policy" },
];
---

<Base
  title="Cookie Policy | Optim Toldos"
  description="Cookie policy of Optim Toldos: which cookies we use, what they do and how you can manage them."
  breadcrumbs={breadcrumbs}
  locale="en"
  alternateUrls={alternateUrls}
>
  <Navbar client:load locale="en" />

  <main>
    <section class="relative min-h-[85vh] flex items-center justify-center overflow-hidden">
      <img
        src={url("/images/pergolas/pergola-lamas-1280.webp")}
        srcset={`${url("/images/pergolas/pergola-lamas-480.webp")} 480w, ${url("/images/pergolas/pergola-lamas-768.webp")} 768w, ${url("/images/pergolas/pergola-lamas-1280.webp")} 1280w, ${url("/images/pergolas/pergola-lamas.webp")} 1920w`}
        sizes="100vw"
        width="1920"
        height="1442"
        fetchpriority="high"
        alt="Bioclimatic pergola louvres"
        class="absolute inset-0 w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-black/40"></div>
      <div class="relative z-10 max-w-4xl mx-auto px-4 text-center py-20">
        <h1 class="font-serif text-4xl md:text-5xl text-white">Cookie Policy</h1>
      </div>
    </section>

    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
      <p class="text-text-muted text-sm mb-10">Last updated: 13 May 2026</p>

      <div class="prose prose-lg max-w-none prose-headings:font-serif prose-headings:text-navy prose-a:text-terracotta">
        <h2>1. What are cookies?</h2>
        <p>
          Cookies are small text files that websites store on your device when you visit them. They allow information about your visit to be remembered, such as your preferred language or other preferences.
        </p>

        <h2>2. Cookies used on this website</h2>

        <h3>Essential cookies (always active)</h3>
        <p>Essential for the website to function. No consent required.</p>

        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>Purpose</th>
              <th>Duration</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><code>cc_cookie</code></td>
              <td>Set by our consent manager (vanilla-cookieconsent). Stores your per-category decision: necessary, functional, analytics and advertising.</td>
              <td>6 months</td>
            </tr>
            <tr>
              <td><code>localStorage: language preference</code></td>
              <td>Remembers the selected language.</td>
              <td>Permanent</td>
            </tr>
            <tr>
              <td><code>cf_chl_*</code> (Cloudflare Turnstile)</td>
              <td>Anti-bot protection on the contact and quote forms. Strictly necessary for site security and exempt from consent under ePrivacy.</td>
              <td>Up to 30 minutes</td>
            </tr>
          </tbody>
        </table>

        <h3>Analytics and advertising cookies (optional)</h3>
        <p>
          If you accept cookies via the banner, we load Google Tag Manager (GTM) on the page, which fires Google Analytics 4 (GA4) for traffic measurement and Google Ads for campaign conversion tracking and <strong>personalised and non-personalised ads</strong>, including remarketing. For <strong>ad personalisation</strong>, Google and we may use cookies and, in mobile apps, <strong>mobile advertising identifiers</strong>.
        </p>
        <p>
          We implement Google's <strong>Consent Mode v2</strong> with default-deny. Until you accept, all four signals — <code>analytics_storage</code>, <code>ad_storage</code>, <code>ad_user_data</code> and <code>ad_personalization</code> — remain <em>denied</em> and no analytics or advertising cookies are stored on your device. If you reject or do not accept, Google tags may still load but operate in redacted mode (<code>ads_data_redaction</code>): requests are sent without cookies or identifiers so that Google can model aggregated conversions without processing personal data.
        </p>
        <p>
          For more information on how Google uses data from its advertising business partners, see <a href="https://business.safety.google/privacy/" target="_blank" rel="noopener noreferrer">business.safety.google/privacy</a>.
        </p>

        <h3>Third-party cookies</h3>
        <p>
          When you accept the banner, the following third parties may set cookies in your browser through Google Tag Manager:
        </p>

        <table>
          <thead>
            <tr>
              <th>Provider</th>
              <th>Cookies</th>
              <th>Purpose</th>
              <th>Duration</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Google Tag Manager</td>
              <td>—</td>
              <td>Loads and manages tags. The GTM container itself does not set cookies.</td>
              <td>—</td>
            </tr>
            <tr>
              <td>Google Analytics 4</td>
              <td><code>_ga</code>, <code>_ga_*</code></td>
              <td>Identify unique visitors and sessions for aggregated traffic analysis.</td>
              <td>Up to 2 years</td>
            </tr>
            <tr>
              <td>Google Ads</td>
              <td><code>_gcl_au</code></td>
              <td>Conversion Linker: attributes ad clicks to on-site conversions.</td>
              <td>~90 days</td>
            </tr>
            <tr>
              <td>Google Ads</td>
              <td><code>_gcl_aw</code>, <code>_gcl_dc</code>, <code>_gcl_gb</code></td>
              <td>Store the ad-click identifier (gclid) for cross-page attribution.</td>
              <td>~90 days</td>
            </tr>
            <tr>
              <td>Google Ads / DoubleClick</td>
              <td><code>IDE</code></td>
              <td>Measures ad effectiveness and enables remarketing audiences.</td>
              <td>~13 months</td>
            </tr>
            <tr>
              <td>Google Ads / DoubleClick</td>
              <td><code>test_cookie</code></td>
              <td>Checks whether the browser supports cookies before serving ads.</td>
              <td>Session</td>
            </tr>
            <tr>
              <td>Google (general)</td>
              <td><code>NID</code>, <code>1P_JAR</code></td>
              <td>Session and preference cookies set by Google domains when consent is granted.</td>
              <td>6 months / 1 month</td>
            </tr>
          </tbody>
        </table>

        <p>
          More about Google's cookies: <a href="https://policies.google.com/technologies/cookies" target="_blank" rel="noopener noreferrer">policies.google.com/technologies/cookies</a>.
        </p>
        <p>
          Google processes Google Analytics and Google Ads data as our data processor. This data may be transferred to the United States under the <strong>EU-US Data Privacy Framework</strong>, under which Google Ireland Limited and Google LLC are certified.
        </p>

        <h2>3. Managing cookies</h2>
        <p>
          You can accept or reject non-essential cookies via the banner that appears when you enter the website. To review or change your choice at any time, use the <strong>"Manage cookies"</strong> link in the footer. You can also manage cookies from your browser settings:
        </p>
        <ul>
          <li>Google Chrome: Settings → Privacy and security → Cookies</li>
          <li>Firefox: Preferences → Privacy &amp; Security</li>
          <li>Safari: Preferences → Privacy</li>
          <li>Edge: Settings → Privacy, search and services</li>
        </ul>

        <h2>4. Changes to this policy</h2>
        <p>
          We reserve the right to modify this Cookie Policy to adapt it to legislative changes or to technical changes on the website. The last updated date indicates the current version.
        </p>

        <h2>5. Contact</h2>
        <p>
          For any questions about this Cookie Policy, contact us at <a href="mailto:info@optimtoldos.com">info@optimtoldos.com</a>.
        </p>
      </div>
    </div>
  </main>

  <Footer client:load locale="en" />
</Base>
