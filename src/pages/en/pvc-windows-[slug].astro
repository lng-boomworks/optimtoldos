---
import Base from '../../layouts/Base.astro';
import { AreaPage } from '../../components/pages/AreaPage';
import {
  buildServiceSchema,
  buildBreadcrumbSchema,
} from '../../utils/schema';
import { SEO_LOCATIONS, EN_PVC_WINDOWS_LOCATIONS } from '../../data/seoLocations';
import { t } from '../../i18n/index';

const SITE = 'https://optimtoldos.com';

// EN PVC windows + zone pages (added 2026-04-30). Pairs with ES /ventanas-pvc-{slug}/.
export async function getStaticPaths() {
  const allowed = new Set<string>(EN_PVC_WINDOWS_LOCATIONS);
  return SEO_LOCATIONS
    .filter((loc) => allowed.has(loc.slug))
    .map((loc) => ({
      params: { slug: loc.slug },
      props: { i: loc.i, slug: loc.slug },
    }));
}

const { slug, i } = Astro.props;
const name = t('en', `serviceAreas.location.${i}.name` as any);
const body = t('en', `serviceAreas.location.${i}.body` as any);
const heading = t('en', 'areaPage.focus.pvcWindows.heading').replace('{location}', name);
const intro = t('en', 'areaPage.focus.pvcWindows.intro').replace('{location}', name);

const alternateUrls = [
  { locale: 'es' as const, href: `${SITE}/ventanas-pvc-${slug}/` },
  { locale: 'en' as const, href: `${SITE}/en/pvc-windows-${slug}/` },
];

const pageUrl = `${SITE}/en/pvc-windows-${slug}/`;

const serviceSchema = buildServiceSchema({
  locale: 'en',
  name: heading,
  description: body,
  serviceType: 'PVC window installation',
  url: pageUrl,
  offers: [
    { name: 'Tilt-and-turn PVC windows' },
    { name: 'Sliding PVC windows' },
    { name: 'PVC entrance and balcony doors' },
  ],
});

const breadcrumbs = [
  { name: 'Home', url: `${SITE}/en/` },
  { name: 'PVC windows', url: `${SITE}/en/pvc-windows/` },
  { name, url: pageUrl },
];

const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbs, { locale: 'en' });
---

<Base
  title={`${heading} - Optim Toldos`}
  description={intro}
  locale="en"
  alternateUrls={alternateUrls}
  breadcrumbs={breadcrumbs}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>
  <AreaPage client:load locale="en" locationSlug={slug} focus="pvc-windows" />
</Base>
