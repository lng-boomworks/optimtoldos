---
import Base from '../layouts/Base.astro';
import { ProductZonePage } from '../components/pages/ProductZonePage';
import {
  buildServiceSchema,
  buildBreadcrumbSchema,
  buildFAQSchema,
  buildProductSchema,
} from '../utils/schema';

const SITE = 'https://optimtoldos.com';
const slug = 'benidorm';
const name = 'Benidorm';
const heading = `Pérgolas en ${name}`;
const intro = `Pérgolas para áticos de gran altura, urbanizaciones de Rincón de Loix y chalets de Sierra Helada: aluminio marino y motores con sensor de viento.`;

const pageUrl = `${SITE}/pergolas-${slug}/`;
const alternateUrls = [
  { locale: 'es' as const, href: pageUrl },
  { locale: 'en' as const, href: `${SITE}/en/pergolas-benidorm/` },
];

const locationParagraph = `Benidorm es atípica: rascacielos en primera línea (Levante y Poniente), urbanizaciones bajas en Rincón de Loix y la zona Aiguera, y chalets dispersos por Sierra Helada y la Cala. Los áticos a 80 - 200 m de altura están expuestos a vientos de levante y a brisa marina constante, lo que dispara el grado de protección que pedimos a una pérgola: tornillería A4, lacado marino, sensor de viento obligado y, en alturas, anclajes con cálculo estructural firmado. La rotación turística también introduce restricciones de comunidad: muchos edificios prohíben modificaciones visibles desde el paseo.`;

const whyFitsBullets = [
  'Cálculo estructural firmado por arquitecto en pérgolas de áticos a más de 50 m de altura (obligatorio).',
  'Tornillería A4 inoxidable y lacado marino: la salinidad en altura es agresiva.',
  'Sensor de viento con umbral bajo (50 - 60 km/h) y motor de cierre rápido (Somfy/Nice).',
  'Estética neutra (blanco, gris claro) aceptada por las comunidades de Levante y Poniente.',
  'Cierres cristal corredera o ZIP screen para que el ático sea utilizable los meses de viento.',
];

const caseStudy = `Caso reciente: pérgola bioclimática 4×3 m en ático planta 28 de la Avenida del Mediterráneo (Levante), aluminio lacado RAL 9006 (gris plata), tornillería A4, motor Somfy io con sensor de viento (50 km/h) y de lluvia, una cortina cristal corredera de 4 m al norte. Cálculo estructural de la cubierta firmado por arquitecto técnico antes del montaje.`;

const priceBand = `Pérgola fija de aluminio 3×3 m: 2.500 € - 3.300 €. Pérgola bioclimática 4×3 m motorizada con sensores: 4.600 € - 6.200 €. Adicional cálculo estructural en altura: 350 € - 600 €. Cerramiento cristal corredera por paño 4 m: 1.800 € - 2.800 €.`;

const comunidadNote = `Las comunidades de los rascacielos de Benidorm son especialmente estrictas: muchos estatutos prohíben modificar la fachada o instalar elementos visibles desde el paseo. La pérgola en ático casi siempre exige acuerdo de la junta y un proyecto técnico firmado, además de declaración responsable o licencia en el Ayuntamiento. Le acompañamos en todo el proceso, incluyendo asistencia a la junta si es necesario.`;

const faqs = [
  { q: '¿Puedo poner una pérgola en un ático de la Avenida del Mediterráneo?', a: 'Depende del estatuto de la comunidad. Muchos rascacielos de Benidorm exigen aprobación de junta por unanimidad o mayoría cualificada para modificar la fachada visible. Si los estatutos lo permiten, sí. Le ayudamos a presentar el proyecto.' },
  { q: '¿La altura cambia el precio?', a: 'Sí. A partir del 5º piso suben los costes de transporte (grúa o ascensor de carga, normativa específica del fabricante) y a partir de planta 20 normalmente exigimos cálculo estructural firmado. Eso suma 350 - 600 € al presupuesto base.' },
  { q: '¿Aguanta el levante a 100 m de altura?', a: 'Con sensor de viento configurado a 50 - 60 km/h y lamas cerradas, sí. Los fabricantes certifican hasta 130 km/h con lamas cerradas; nunca dejamos pérgolas en altura sin sensor automático de viento.' },
  { q: '¿Es mejor pérgola o toldo extensible en Benidorm?', a: 'Pérgola bioclimática salvo presupuesto muy limitado. El levante destroza toldos extensibles si no se recogen a tiempo; la bioclimática cierra automáticamente y la estructura es fija. La inversión inicial es mayor pero la durabilidad es 3 - 4 veces superior.' },
  { q: '¿Cuánto se tarda en montar en un ático en altura?', a: 'Una pérgola estándar lleva 2 - 3 días por la logística de subir el material. Si requiere grúa exterior la planificación añade 1 - 2 semanas porque hay que reservar y permisos del Ayuntamiento.' },
];

const related = [
  { label: 'Toldos en Benidorm', href: '/toldos-benidorm/' },
  { label: 'Toldos hostelería en Benidorm', href: '/toldos-hosteleria-benidorm/' },
  { label: 'Cortinas de cristal en Benidorm', href: '/cortinas-de-cristal-benidorm/' },
  { label: 'Pérgolas (catálogo)', href: '/pergolas/' },
  { label: 'Bioclimática vs aluminio', href: '/pergola-bioclimatica-vs-aluminio/' },
];

const ctaHref = `/presupuesto/?product=pergolas&location=${slug}`;
const contactHref = '/contacto/';
const licenceHref = '/guia-licencias-pergolas-toldos-alicante/';

const breadcrumbs = [
  { name: 'Inicio', url: `${SITE}/` },
  { name: 'Pérgolas', url: `${SITE}/pergolas/` },
  { name, url: pageUrl },
];

const serviceSchema = buildServiceSchema({
  locale: 'es',
  name: heading,
  description: intro,
  serviceType: 'Instalación de pérgolas',
  url: pageUrl,
  offers: [
    { name: 'Pérgola bioclimática' },
    { name: 'Pérgola fija de aluminio' },
    { name: 'Pérgola en altura con cálculo estructural' },
  ],
});
const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbs, { locale: 'es' });
const faqSchema = buildFAQSchema(faqs.map(f => ({ question: f.q, answer: f.a })), { locale: 'es' });
const productSchema = buildProductSchema({
  locale: 'es',
  name: heading,
  description: intro,
  image: `${SITE}/images/pergolas/pergola-bioclimatica.webp`,
  url: pageUrl,
  category: 'Pérgolas',
  lowPrice: '2500',
  highPrice: '10000',
});
---

<Base
  title={`${heading} - Optim Toldos`}
  description={intro}
  locale="es"
  alternateUrls={alternateUrls}
  breadcrumbs={breadcrumbs}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  </Fragment>
  <ProductZonePage
    client:load
    locale="es"
    heading={heading}
    intro={intro}
    heroImage="/images/pergolas/hero-pergolas-1280.webp"
    locationParagraph={locationParagraph}
    whyFitsBullets={whyFitsBullets}
    caseStudy={caseStudy}
    priceBand={priceBand}
    comunidadNote={comunidadNote}
    licenceHref={licenceHref}
    faqs={faqs}
    related={related}
    ctaHref={ctaHref}
    contactHref={contactHref}
  />
</Base>
