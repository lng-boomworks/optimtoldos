---
import Base from '../layouts/Base.astro';
import { ProductZonePage } from '../components/pages/ProductZonePage';
import {
  buildServiceSchema,
  buildBreadcrumbSchema,
  buildFAQSchema,
} from '../utils/schema';

const SITE = 'https://optimtoldos.com';
const slug = 'dolores';
const name = 'Dolores';
const heading = `Velas de sombra en ${name}`;
const intro = `Velas de sombra para chalets, casas con parcela y zonas de piscina en Dolores y la Vega Baja interior: tejido HDPE técnico, anclajes inoxidables y diseño según orientación.`;

const pageUrl = `${SITE}/velas-sombra-${slug}/`;
const alternateUrls = [{ locale: 'es' as const, href: pageUrl }];

const locationParagraph = `Dolores y los pueblos vecinos de la Vega Baja interior (Catral, San Felipe Neri, Daya Vieja) tienen un parque de viviendas dominado por chalets, casas con parcela y huertos reformados con piscina. La distancia al mar (15 km) reduce el efecto del aire salino, pero el sol del verano interior es más intenso por la falta de brisa marina y las temperaturas medias en julio-agosto rondan los 35 °C al mediodía. La vela de sombra es la solución más versátil: cubre piscinas y zonas de comida sin obra, se monta en una jornada y permite ampliar el espacio útil del chalet en 30 - 40 m² extras de zona habitable al aire libre.`;

const whyFitsBullets = [
  'Sol intenso y poca brisa interior: la vela aporta sombra fresca con tejido transpirable.',
  'Piscinas privadas frecuentes en chalets de la Vega Baja: la vela es la cobertura ideal sin perder luz natural.',
  'Tejido HDPE técnico: bloquea 90 - 95 % UV, durabilidad 8 - 10 años con uso intensivo.',
  'Postes de aluminio o acero galvanizado donde no hay fachada, base hormigonada disimulada en jardín.',
  'Coste y plazo muy inferiores a una pérgola, sin obra ni licencia urbanística (al ser desmontable).',
];

const caseStudy = `Caso reciente: vela rectangular de 5×4 m sobre porche de piscina en chalet de Dolores, tejido HDPE crema, dos anclajes a fachada y dos postes de aluminio anodizado de 2,8 m con base hormigonada bajo el pavimento existente. Una jornada de instalación, plazo desde firma 2 semanas.`;

const comunidadNote = `En zonas residenciales de Dolores la vela desmontable suele aceptarse sin licencia urbanística (no es estructura permanente) y sin autorización de comunidad si los postes se anclan en parcela privativa. Si tiene parcela en complejo cerrado, conviene comunicar a la junta antes de instalar. Le entregamos plano y especificación técnica del tejido para cualquier trámite.`;

const faqs = [
  { q: '¿La vela aporta sombra suficiente para una piscina?', a: 'El HDPE técnico bloquea 90 - 95 % de la radiación UV. Sobre piscina, una vela de 5×4 m cubre cómodamente la zona de bañistas y parte del agua. Si quiere cubrir el vaso completo de piscina, calculamos una vela mayor o varias velas combinadas en visita técnica.' },
  { q: '¿Aguanta el calor extremo del verano interior?', a: 'Sí. El HDPE es transpirable: deja pasar el aire (no se acumula calor debajo), y refleja una parte de la radiación. Bajo una vela bien tensada la sensación térmica baja 6 - 8 °C respecto al sol directo, suficiente para la zona de comida o tumbonas en pleno agosto.' },
  { q: '¿Tengo que cimentar los postes en parcela natural?', a: 'Si el suelo es jardín o tierra, sí: dado de hormigón de 50×50×60 cm para garantizar la tensión a lo largo del tiempo. Si el suelo es pavimento existente (hormigón impreso, gres), podemos atornillar a placa y evitar la cimentación.' },
  { q: '¿La retiran ustedes en invierno?', a: 'Sí. Como servicio anual retiramos en otoño, guardamos la vela en almacén climatizado y reinstalamos en primavera con revisión de anclajes y limpieza del tejido. Coste habitual: 70 - 120 € por vela y temporada.' },
];

const related = [
  { label: 'Toldos en Dolores', href: '/toldos-dolores/' },
  { label: 'Velas de sombra (catálogo)', href: '/velas-de-sombra/' },
  { label: 'Toldos en Rojales', href: '/toldos-rojales/' },
  { label: 'Toldos en Guardamar', href: '/toldos-guardamar/' },
];

const ctaHref = `/presupuesto/?product=velas-sombra&location=${slug}`;
const contactHref = '/contacto/';
const licenceHref = '/guia-licencias-pergolas-toldos-alicante/';

const breadcrumbs = [
  { name: 'Inicio', url: `${SITE}/` },
  { name: 'Velas de sombra', url: `${SITE}/velas-de-sombra/` },
  { name, url: pageUrl },
];

const serviceSchema = buildServiceSchema({
  locale: 'es',
  name: heading,
  description: intro,
  serviceType: 'Instalación de velas de sombra',
  url: pageUrl,
  offers: [
    { name: 'Vela triangular' },
    { name: 'Vela rectangular' },
    { name: 'Vela pentagonal a medida' },
  ],
});
const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbs, { locale: 'es' });
const faqSchema = buildFAQSchema(faqs.map(f => ({ question: f.q, answer: f.a })), { locale: 'es' });
---

<Base
  title={`${heading} - Optim Toldos`}
  description={intro}
  locale="es"
  alternateUrls={alternateUrls}
  breadcrumbs={breadcrumbs}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>
  <ProductZonePage
    client:load
    locale="es"
    heading={heading}
    intro={intro}
    heroImage="/images/velas/hero-velas-1280.webp"
    locationParagraph={locationParagraph}
    whyFitsBullets={whyFitsBullets}
    caseStudy={caseStudy}
    comunidadNote={comunidadNote}
    licenceHref={licenceHref}
    faqs={faqs}
    related={related}
    ctaHref={ctaHref}
    contactHref={contactHref}
  />
</Base>
