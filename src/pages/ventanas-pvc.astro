---
import Base from '../layouts/Base.astro';
import { VentanasPage } from '../components/pages/VentanasPage';
import { buildFAQSchema, buildServiceSchema, buildProductSchema } from '../utils/schema';
import { t } from '../i18n/index';
import { getAlternateUrls } from '../i18n/routes';

const alternateUrls = getAlternateUrls('pvc-windows');

const ventanasFaqs = Array.from({ length: 8 }, (_, i) => ({
  question: t('es', `windows.faq.${i + 1}.q` as any),
  answer: t('es', `windows.faq.${i + 1}.a` as any),
}));

const breadcrumbs = [
  { name: "Inicio", url: "https://optimtoldos.com/" },
  { name: "Ventanas PVC", url: "https://optimtoldos.com/ventanas-pvc" },
];

const productSchema = buildProductSchema({
  name: "Ventanas y Puertas PVC en Alicante",
  description: "Ventanas y puertas de PVC correderas, abatibles y oscilobatientes. Máximo aislamiento térmico y acústico. Certificación CE.",
  image: "https://optimtoldos.com/images/gallery/hero-ventanas.webp",
  url: "https://optimtoldos.com/ventanas-pvc",
  category: "Ventanas PVC",
});
---

<Base
  title="Ventanas y Puertas PVC | Optim Toldos — Alicante"
  description="Ventanas y puertas de PVC de alta eficiencia energética. Aislamiento térmico y acústico superior. Instalación profesional en Alicante."
  breadcrumbs={breadcrumbs}
  locale="es"
  alternateUrls={alternateUrls}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(buildServiceSchema({
      name: "Ventanas y Puertas de PVC en Alicante",
      description: "Instalación de ventanas y puertas de PVC de alta eficiencia energética con aislamiento térmico y acústico superior.",
      serviceType: "Instalación de ventanas PVC",
      url: "https://optimtoldos.com/ventanas-pvc",
      offers: [{ name: "Ventana Corredera PVC" }, { name: "Ventana Abatible PVC" }, { name: "Ventana Oscilobatiente PVC" }],
    }))} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(buildFAQSchema(ventanasFaqs))} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  </Fragment>
  <VentanasPage client:load locale="es" />
</Base>
