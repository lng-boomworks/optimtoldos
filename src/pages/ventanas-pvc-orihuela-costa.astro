---
import Base from '../layouts/Base.astro';
import { ProductZonePage } from '../components/pages/ProductZonePage';
import {
  buildServiceSchema,
  buildBreadcrumbSchema,
  buildFAQSchema,
} from '../utils/schema';

const SITE = 'https://optimtoldos.com';
const slug = 'orihuela-costa';
const name = 'Orihuela Costa';
const heading = `Ventanas de PVC en ${name}`;
const intro = `Ventanas de PVC con triple junta y vidrio bajo emisivo en Orihuela Costa: aislamiento térmico y acústico para chalets, dúplex y apartamentos en Cabo Roig, La Zenia, Punta Prima y Villamartín. Resistentes al aire salino, mantenimiento mínimo.`;

const pageUrl = `${SITE}/ventanas-pvc-${slug}/`;
const alternateUrls = [{ locale: 'es' as const, href: pageUrl }];

const locationParagraph = `Orihuela Costa concentra el mayor parque de segunda residencia y vivienda expat de la provincia: chalets adosados, dúplex y apartamentos en urbanizaciones de Cabo Roig, La Zenia, Punta Prima, Villamartín y Playa Flamenca. La mayoría se construyeron entre 1985 y 2010 con carpintería de aluminio sin RPT (los más antiguos) o con RPT básica (los más modernos), todos sufriendo el aire salino abrasivo de primera y segunda línea de costa. La sustitución por PVC con triple junta resuelve simultáneamente: corrosión por salino (PVC inerte), pérdidas térmicas (clave en propiedades que se calientan o enfrían rápido tras periodos sin uso), y aislamiento acústico para urbanizaciones cercanas a vías rápidas como la N-332.`;

const whyFitsBullets = [
  'Inmunidad al aire salino: PVC inerte al cloruro sódico, vida útil 30 - 40 años en costa.',
  'Aislamiento térmico Uw 1,1 - 1,3 W/m²K con vidrio doble bajo emisivo: la propiedad mantiene temperatura en periodos de no uso.',
  'Triple junta perimetral: estanqueidad ante levantes y temporales del Mediterráneo.',
  'Aislamiento acústico relevante en urbanizaciones cercanas a la N-332 o la AP-7.',
  'Mantenimiento mínimo: limpieza con jabón neutro 1 - 2 veces al año, ideal para segunda residencia.',
];

const caseStudy = `Caso reciente: sustitución completa de ventanas en dúplex de 110 m² en Villamartín, 7 huecos con vidrio doble bajo emisivo y perfil Aluplast Ideal 7000 (5 cámaras), color blanco interior y antracita exterior. Coordinación con propietario residente en Reino Unido a través de su gestor local: trabajos en 3 jornadas con piso entregado limpio. Plazo desde firma 4 - 5 semanas.`;

const comunidadNote = `En Orihuela Costa la sustitución de ventanas en el hueco existente es comunicación previa de obra menor. La mayoría de urbanizaciones tienen estatutos con normas de uniformidad de fachada (color, acabado, modelo de persiana): revisamos los estatutos antes de presupuestar. Para propietarios no residentes en España coordinamos con gestor o vecino designado para acceso, dejando el inmueble entregado y limpio.`;

const faqs = [
  { q: 'Soy propietario británico no residente. ¿Pueden gestionarlo en mi ausencia?', a: 'Sí, es un caso muy frecuente en Orihuela Costa. Coordinamos con su gestor local, vecino o agencia de mantenimiento para acceso al inmueble durante la instalación, y le mantenemos informado por correo y WhatsApp con fotos del avance. Al terminar entregamos el piso limpio.' },
  { q: '¿Por qué PVC y no aluminio en una segunda residencia?', a: 'Porque la propiedad pasa periodos largos sin uso y el aire salino abrasivo del Mediterráneo afecta especialmente a la carpintería expuesta. El PVC es inerte al salino, sin mantenimiento, mientras que el aluminio sin tratamiento se corroe y el aluminio con RPT requiere revisión periódica.' },
  { q: '¿Cuánto ahorro en climatización?', a: 'Frente a aluminio sin RPT (la mayoría del parque antiguo de la zona), 25 - 35 % en climatización. Frente a aluminio con RPT moderno, 15 - 20 %. La amortización está entre 7 y 12 años según uso.' },
  { q: '¿Aguanta el levante fuerte de la zona?', a: 'Sí. La triple junta y la fijación con tornillería específica garantizan estanqueidad ante temporales. Las ventanas profesionales se prueban a 200 km/h sin pérdida de estanqueidad.' },
];

const related = [
  { label: 'Ventanas PVC (catálogo)', href: '/ventanas-pvc/' },
  { label: 'Toldos en Orihuela Costa', href: '/toldos-orihuela-costa/' },
  { label: 'Cortinas de cristal en Orihuela Costa', href: '/cortinas-de-cristal-orihuela-costa/' },
  { label: 'Pérgolas en Orihuela Costa', href: '/pergolas-orihuela-costa/' },
];

const ctaHref = `/presupuesto/?product=ventanas-pvc&location=${slug}`;
const contactHref = '/contacto/';
const licenceHref = '/guia-licencias-pergolas-toldos-alicante/';

const breadcrumbs = [
  { name: 'Inicio', url: `${SITE}/` },
  { name: 'Ventanas PVC', url: `${SITE}/ventanas-pvc/` },
  { name, url: pageUrl },
];

const serviceSchema = buildServiceSchema({
  locale: 'es',
  name: heading,
  description: intro,
  serviceType: 'Instalación de ventanas de PVC',
  url: pageUrl,
  offers: [
    { name: 'Ventana PVC oscilobatiente' },
    { name: 'Ventana PVC corredera' },
    { name: 'Puerta balconera y de entrada PVC' },
  ],
});
const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbs, { locale: 'es' });
const faqSchema = buildFAQSchema(faqs.map(f => ({ question: f.q, answer: f.a })), { locale: 'es' });
---

<Base
  title={`${heading} - Optim Toldos`}
  description={intro}
  locale="es"
  alternateUrls={alternateUrls}
  breadcrumbs={breadcrumbs}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>
  <ProductZonePage
    client:load
    locale="es"
    heading={heading}
    intro={intro}
    heroImage="/images/ventanas/hero-ventanas-1280.webp"
    locationParagraph={locationParagraph}
    whyFitsBullets={whyFitsBullets}
    caseStudy={caseStudy}
    comunidadNote={comunidadNote}
    licenceHref={licenceHref}
    faqs={faqs}
    related={related}
    ctaHref={ctaHref}
    contactHref={contactHref}
  />
</Base>
