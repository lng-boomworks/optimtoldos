---
import Base from '../layouts/Base.astro';
import { ProductZonePage } from '../components/pages/ProductZonePage';
import {
  buildServiceSchema,
  buildBreadcrumbSchema,
  buildFAQSchema,
  buildProductSchema,
} from '../utils/schema';

const SITE = 'https://optimtoldos.com';
const slug = 'torrevieja';
const name = 'Torrevieja';
const heading = `Cortinas de cristal en ${name}`;
const intro = `Cortinas de cristal correderas y plegables sin perfiles verticales para áticos, terrazas y locales de Torrevieja. Vidrio templado de 10 mm con tratamiento marino.`;

const pageUrl = `${SITE}/cortinas-de-cristal-${slug}/`;
const alternateUrls = [
  { locale: 'es' as const, href: pageUrl },
  { locale: 'en' as const, href: `${SITE}/en/glass-curtains-${slug}/` },
];

const locationParagraph = `En Torrevieja la cortina de cristal cierra la terraza sin renunciar a las vistas: el sistema sin perfiles verticales convierte el ático en un comedor exterior protegido del levante y de la salinidad sin que se vean barrotes. Funciona especialmente bien en bloques cercanos al paseo y en áticos pequeños donde una cortina de cristal añade entre 8 y 12 m² útiles a la vivienda. La sal del Mediterráneo exige perfiles de aluminio anodizado o lacado marino y herrajes A4 inoxidables; los vientos de levante de tarde recomiendan un sistema sólido (perfil superior reforzado) y, en alturas, un cierre de seguridad superior.`;

const whyFitsBullets = [
  'Sistema sin perfiles verticales: máxima visibilidad para conservar las vistas al mar o al paseo.',
  'Vidrio templado 10 mm: aguanta los impactos y los vientos de levante de Torrevieja.',
  'Perfil de aluminio anodizado o lacado marino: imprescindible cerca del mar.',
  'Herrajes A4 inoxidables: zonas costeras requieren grado A4 (no A2 estándar).',
  'Cierre con tornillería oculta y juntas EPDM: estanqueidad para usar en invierno.',
];

const caseStudy = `Caso reciente: cortina de cristal corredera de 6 paños sobre terraza de ático en Habaneras, vidrio templado 10 mm transparente, perfil aluminio lacado RAL 9016 con tratamiento marino, herrajes A4 inoxidables y guía superior reforzada. Total una jornada de instalación, plazo desde firma 4 semanas.`;

const priceBand = `Cortina de cristal corredera 4 paños (3 m): 1.800 € - 2.500 €. Cortina 6 paños (4,5 m): 2.700 € - 3.600 €. Cortina plegable (apertura total) 6 paños: 3.200 € - 4.200 €. Vidrio low-iron extra-claro: +15 - 20 %.`;

const comunidadNote = `En Torrevieja la cortina de cristal en terraza privativa normalmente sólo requiere acuerdo de la junta de propietarios, ya que es un cerramiento desmontable y no aumenta superficie construida según la jurisprudencia mayoritaria. El Ayuntamiento puede pedir comunicación previa. Le entregamos planos cotados, ficha del fabricante y documento explicativo para presentar a la administración de fincas.`;

const faqs = [
  { q: '¿Una cortina de cristal en un ático de Torrevieja necesita licencia urbanística?', a: 'Habitualmente no, basta con comunicación previa. La cortina es desmontable, sin marco vertical y no incrementa superficie construida. Pero requiere acuerdo de la junta de propietarios porque modifica el aspecto de la terraza desde fachada. Le ayudamos a documentar la propuesta.' },
  { q: '¿Aguanta el viento de levante?', a: 'Sí, con el sistema correcto. Los perfiles superiores reforzados y el vidrio templado de 10 mm aguantan rachas de 90 - 100 km/h sin problema. Para alturas (más de planta 5) recomendamos un cierre adicional de seguridad superior.' },
  { q: '¿La sal del Mediterráneo daña los herrajes?', a: 'Si son de calidad inferior (A2), sí. Por eso siempre montamos con herrajes A4 inoxidables y perfilería de aluminio anodizado o lacado marino. La diferencia es de unos 80 - 120 € en una cortina de 4 m, pero la durabilidad pasa de 5 - 7 años a más de 15.' },
  { q: '¿Puedo seguir poniendo el toldo o un estor exterior con la cortina?', a: 'Sí. La cortina de cristal funciona perfectamente bajo un toldo o un estor. De hecho la combinación más eficaz en Torrevieja es cortina de cristal + estor de tejido técnico interior, que da privacidad y bloquea radiación solar.' },
  { q: '¿Cuánto se tarda en instalar?', a: 'Una cortina estándar de 4 - 6 m se monta en una jornada. El plazo total desde la firma del presupuesto hasta el montaje suele ser 3 - 5 semanas, dependiendo del color de los perfiles.' },
];

const related = [
  { label: 'Pérgolas en Torrevieja', href: '/pergolas-torrevieja/' },
  { label: 'Pérgola bioclimática en Torrevieja', href: '/pergola-bioclimatica-torrevieja/' },
  { label: 'Toldos en Torrevieja', href: '/toldos-torrevieja/' },
  { label: 'Cortinas de cristal (catálogo)', href: '/cortinas-de-cristal/' },
  { label: 'Guía de cortinas de cristal', href: '/guia-cortinas-cristal-terraza/' },
];

const ctaHref = `/presupuesto/?product=cortinas-cristal&location=${slug}`;
const contactHref = '/contacto/';
const licenceHref = '/guia-licencias-pergolas-toldos-alicante/';

const breadcrumbs = [
  { name: 'Inicio', url: `${SITE}/` },
  { name: 'Cortinas de cristal', url: `${SITE}/cortinas-de-cristal/` },
  { name, url: pageUrl },
];

const serviceSchema = buildServiceSchema({
  locale: 'es',
  name: heading,
  description: intro,
  serviceType: 'Instalación de cortinas de cristal',
  url: pageUrl,
  offers: [
    { name: 'Cortina de cristal corredera' },
    { name: 'Cortina de cristal plegable' },
    { name: 'Cerramiento sin perfiles verticales' },
  ],
});
const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbs, { locale: 'es' });
const faqSchema = buildFAQSchema(faqs.map(f => ({ question: f.q, answer: f.a })), { locale: 'es' });
const productSchema = buildProductSchema({
  locale: 'es',
  name: heading,
  description: intro,
  image: `${SITE}/images/cortinas/cortina-cristal-1.webp`,
  url: pageUrl,
  category: 'Cortinas de cristal',
  lowPrice: '1800',
  highPrice: '4200',
});
---

<Base
  title={`${heading} - Optim Toldos`}
  description={intro}
  locale="es"
  alternateUrls={alternateUrls}
  breadcrumbs={breadcrumbs}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  </Fragment>
  <ProductZonePage
    client:load
    locale="es"
    heading={heading}
    intro={intro}
    heroImage="/images/cortinas/hero-cortinas-1280.webp"
    locationParagraph={locationParagraph}
    whyFitsBullets={whyFitsBullets}
    caseStudy={caseStudy}
    priceBand={priceBand}
    comunidadNote={comunidadNote}
    licenceHref={licenceHref}
    faqs={faqs}
    related={related}
    ctaHref={ctaHref}
    contactHref={contactHref}
  />
</Base>
