# Public env vars baked into the client bundle at build time.
# Set the same key in Cloudflare Pages → Settings → Environment variables
# (Build) for production.

# Cloudflare Turnstile site key. The always-pass test key is below — replace
# with your real site key before going live. The key is public by design;
# it can ship in HTML.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
